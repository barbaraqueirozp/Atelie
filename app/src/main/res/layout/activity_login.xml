<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp">

        <!-- ================= LOGO ================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_logo"
                android:gravity="center"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ateliê"
                    android:textColor="#202033"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="mercado de arte"
                    android:textColor="#817977"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================= CARD CORAL ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_login"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            android:paddingTop="30dp"
            android:paddingBottom="28dp">

            <!-- TÍTULO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bem-vindo&#10;de volta!"
                android:textColor="#202033"
                android:textSize="34sp"
                android:textStyle="bold"
                android:lineSpacingExtra="-3dp" />

            <!-- DESCRIÇÃO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Entre na sua conta para continuar&#10;explorando o melhor da arte."
                android:textColor="#594E4D"
                android:textSize="16sp"
                android:lineSpacingExtra="2dp" />


            <!-- E-MAIL -->

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="27dp"
                android:background="@drawable/bg_campo_login"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- SENHA -->

            <EditText
                android:id="@+id/edtSenha"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campo_login"
                android:hint="Senha"
                android:inputType="textPassword"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- ESQUECI MINHA SENHA -->

            <TextView
                android:id="@+id/txtEsqueciSenha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:text="Esqueci minha senha"
                android:textColor="#3575E6"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- ENTRAR -->

            <TextView
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="23dp"
                android:background="@drawable/bg_botao_entrar"
                android:gravity="center"
                android:text="Entrar"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================= OU ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:gravity="center_vertical">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D4CCC8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:text="ou"
                android:textColor="#817977"
                android:textSize="15sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D4CCC8" />

        </LinearLayout>


        <!-- ================= CRIAR CONTA ================= -->

        <TextView
            android:id="@+id/btnCriarConta"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_botao_criar"
            android:gravity="center"
            android:text="Criar uma conta"
            android:textColor="#202033"
            android:textSize="17sp"
            android:textStyle="bold" />


        <!-- ================= TERMOS ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Ao continuar, você concorda com nossos termos de uso."
            android:textColor="#9A918E"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>