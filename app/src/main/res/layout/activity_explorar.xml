<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF4E4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Filtros de categorias -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filtroEmAlta"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_filtro_ativo"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Em alta"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/filtroPintura"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_filtro"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Pintura"
                    android:textColor="#261B16"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/filtroEscultura"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_filtro"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Escultura"
                    android:textColor="#261B16"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/filtroFotografia"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_filtro"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Fotografia"
                    android:textColor="#261B16"
                    android:textSize="16sp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explorar"
            android:textColor="#261B16"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Obras disponíveis para compra agora."
            android:textColor="#746C68"
            android:textSize="17sp" />

        <!-- Título da seção -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pintura"
                android:textColor="#261B16"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver obras"
                android:textColor="#FF5B3D"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cards de pinturas -->
        <HorizontalScrollView
            android:id="@+id/listaPinturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <!-- Primeira obra -->
                <LinearLayout
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_obra"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="165dp"
                        android:background="@drawable/bg_imagem_obra_1"
                        android:clipToOutline="true"
                        android:contentDescription="Obra Brisa Tropical"
                        android:scaleType="centerCrop"
                        android:src="@drawable/brisa_tropical" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Brisa Tropical"
                        android:textColor="#261B16"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Marina Duarte"
                        android:textColor="#746C68"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="R$ 1.240"
                        android:textColor="#261B16"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Segunda obra -->
                <LinearLayout
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_card_obra"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="165dp"
                        android:background="@drawable/bg_imagem_obra_2"
                        android:clipToOutline="true"
                        android:contentDescription="Obra Sol de Março"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sol_de_marco" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Sol de Março"
                        android:textColor="#261B16"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Marina Duarte"
                        android:textColor="#746C68"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="R$ 1.680"
                        android:textColor="#261B16"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/mensagemCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ainda não há obras nesta categoria."
            android:textColor="#746C68"
            android:textSize="17sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>