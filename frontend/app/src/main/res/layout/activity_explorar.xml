<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_creme">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guiaInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/margem_tela" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guiaFim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/margem_tela" />

    <!-- ================= FILTROS DE CATEGORIA ================= -->

    <HorizontalScrollView
        android:id="@+id/scrollFiltros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margem_tela"
        android:paddingEnd="@dimen/margem_tela"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoFiltros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEmAlta"
                    style="@style/Atelie.ChipFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:checked="true"
                    android:text="Em alta" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPintura"
                    style="@style/Atelie.ChipFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pintura" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEscultura"
                    style="@style/Atelie.ChipFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Escultura" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFotografia"
                    style="@style/Atelie.ChipFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fotografia" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- ================= TÍTULO ================= -->

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Explorar"
        android:textColor="@color/texto_escuro"
        android:textSize="38sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/guiaFim"
        app:layout_constraintStart_toStartOf="@id/guiaInicio"
        app:layout_constraintTop_toBottomOf="@id/scrollFiltros" />

    <TextView
        android:id="@+id/txtSubtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Obras disponíveis para compra agora."
        android:textColor="@color/texto_cinza"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="@id/guiaFim"
        app:layout_constraintStart_toStartOf="@id/guiaInicio"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo" />

    <TextView
        android:id="@+id/txtCategoria"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Em alta"
        android:textColor="@color/texto_escuro"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/txtQuantidade"
        app:layout_constraintStart_toStartOf="@id/guiaInicio"
        app:layout_constraintTop_toBottomOf="@id/txtSubtitulo" />

    <TextView
        android:id="@+id/txtQuantidade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/coral"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/txtCategoria"
        app:layout_constraintEnd_toEndOf="@id/guiaFim" />

    <!-- ================= LISTA (RecyclerView em grade) ================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvObras"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtCategoria" />

    <TextView
        android:id="@+id/txtVazio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Ainda não há obras nesta categoria."
        android:textColor="@color/texto_cinza"
        android:textSize="17sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/guiaFim"
        app:layout_constraintStart_toStartOf="@id/guiaInicio"
        app:layout_constraintTop_toBottomOf="@id/txtCategoria" />

</androidx.constraintlayout.widget.ConstraintLayout>
