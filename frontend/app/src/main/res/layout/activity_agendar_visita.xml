<?xml version="1.0" encoding="utf-8"?>
<!-- Agendamento de visita ao ateliê: calendário + horários livres -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_creme"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/margem_tela"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnVoltar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_botao_circular"
                android:contentDescription="Voltar"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/texto_escuro"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Visita ao ateliê"
                android:textColor="@color/texto_cinza"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Agendar visita"
            android:textColor="@color/texto_escuro"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAtelie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/texto_cinza"
            android:textSize="16sp" />

        <!-- Ateliê fechado para visitas -->
        <TextView
            android:id="@+id/txtFechado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:padding="24dp"
            android:text="Este ateliê não está recebendo visitas no momento."
            android:textColor="@color/texto_escuro"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- ===== Calendário ===== -->
        <LinearLayout
            android:id="@+id/secaoCalendario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnMesAnterior"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mês anterior"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/texto_escuro"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/txtMes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/texto_escuro"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnProximoMes"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Próximo mês"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/texto_escuro"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- Dias da semana -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="@color/texto_cinza"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="S"
                    android:textColor="@color/texto_cinza"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="T"
                    android:textColor="@color/texto_cinza"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Q"
                    android:textColor="@color/texto_cinza"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Q"
                    android:textColor="@color/texto_cinza"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="S"
                    android:textColor="@color/texto_cinza"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="S"
                    android:textColor="@color/texto_cinza"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/txtCarregando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="8dp"
                android:text="Carregando agenda..."
                android:textColor="@color/texto_cinza"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Legenda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_ponto_disponivel" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Horários livres"
                    android:textColor="@color/texto_cinza"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtLegendaIndisponivel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="12"
                    android:textColor="@color/icone_inativo"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Indisponível"
                    android:textColor="@color/texto_cinza"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Horários ===== -->
        <LinearLayout
            android:id="@+id/secaoHorarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/txtTituloHorarios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="HORÁRIOS" />

            <TextView
                android:id="@+id/txtEscolhaDia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Escolha um dia com bolinha coral no calendário."
                android:textColor="@color/texto_cinza"
                android:textSize="15sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoHorarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:chipSpacingHorizontal="8dp"
                app:singleSelection="true" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cada visita dura 1 hora. O artista confirma o pedido e então você recebe o endereço do ateliê."
            android:textColor="@color/texto_cinza"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmar"
            style="@style/Atelie.Botao"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="Solicitar visita"
            app:backgroundTint="@color/coral_botao"
            app:cornerRadius="32dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
