<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil do usuário logado: interface de ARTISTA (vendedor) ou de COMPRADOR -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_creme"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/margem_tela"
        android:paddingBottom="32dp">

        <!-- Barra do topo: voltar / sair -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnVoltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/texto_escuro"
                android:textSize="26sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnSair"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Sair"
                android:textColor="@color/texto_cinza"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== Cartão laranja (os dois perfis) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_perfil_cabecalho"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtIniciais"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:textColor="@color/coral"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/texto_escuro"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSubtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/texto_escuro"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Contadores: só para artistas -->
            <LinearLayout
                android:id="@+id/grupoEstatisticas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_estatistica"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.15"
                        android:text="À VENDA"
                        android:textColor="@color/texto_cinza"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtObrasAVenda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="–"
                        android:textColor="@color/texto_escuro"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_estatistica"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.15"
                        android:text="ACERVO"
                        android:textColor="@color/texto_cinza"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtAcervo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="–"
                        android:textColor="@color/texto_escuro"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Aviso para vendedor que ainda não cadastrou o ateliê -->
        <LinearLayout
            android:id="@+id/cardSemAtelie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Falta cadastrar seu ateliê"
                android:textColor="@color/texto_escuro"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Com ele você publica obras e recebe visitas de colecionadores."
                android:textColor="@color/texto_cinza"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCadastrarAtelie"
                style="@style/Atelie.Botao"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:text="Cadastrar ateliê"
                app:backgroundTint="@color/coral_botao" />
        </LinearLayout>

        <!-- ===== Menu (os itens visíveis mudam conforme o tipo de conta) ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Minha conta"
            android:textColor="@color/texto_escuro"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <include
                android:id="@+id/menuAtelie"
                layout="@layout/item_menu_perfil" />
            <include
                android:id="@+id/menuCompras"
                layout="@layout/item_menu_perfil" />
            <include
                android:id="@+id/menuFavoritas"
                layout="@layout/item_menu_perfil" />
            <include
                android:id="@+id/menuNotificacoes"
                layout="@layout/item_menu_perfil" />
            <include
                android:id="@+id/menuConversas"
                layout="@layout/item_menu_perfil" />
            <include
                android:id="@+id/menuConfiguracoes"
                layout="@layout/item_menu_perfil" />
            <include
                android:id="@+id/menuVender"
                layout="@layout/item_menu_perfil" />
        </LinearLayout>

        <!-- ===== Minhas obras: só para artistas ===== -->
        <LinearLayout
            android:id="@+id/secaoObras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Minhas obras"
                    android:textColor="@color/texto_escuro"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnVerComoCliente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="Ver como cliente"
                    android:textColor="@color/coral"
                    android:textSize="15sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMinhasObras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="-6dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/txtSemObras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Você ainda não tem obras à venda."
                android:textColor="@color/texto_cinza"
                android:textSize="15sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublicar"
                style="@style/Atelie.Botao"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:text="Publicar nova obra"
                app:backgroundTint="@color/texto_escuro" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
