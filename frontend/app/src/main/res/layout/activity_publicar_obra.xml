<?xml version="1.0" encoding="utf-8"?>
<!-- Tela para o artista anunciar uma obra (foto pela câmera ou galeria) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_creme"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/margem_tela"
        android:paddingBottom="32dp">

        <!-- ===== Topo ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnVoltar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_botao_circular"
                android:contentDescription="Voltar"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/texto_escuro"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Nova obra"
                android:textColor="@color/texto_cinza"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Publicar obra"
            android:textColor="@color/texto_escuro"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:text="Conte sobre a peça e ela entra na galeria para os colecionadores."
            android:textColor="@color/texto_cinza"
            android:textSize="16sp" />

        <!-- ===== Foto ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="FOTO DA OBRA" />

            <FrameLayout
                android:id="@+id/areaFoto"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_area_foto"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/txtSemFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="📷\nToque para fotografar sua obra"
                    android:textColor="@color/texto_cinza"
                    android:textSize="16sp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Foto da obra"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/FormaImagemObra" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCamera"
                    style="@style/Atelie.Botao.Contorno"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Câmera" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGaleria"
                    style="@style/Atelie.Botao.Contorno"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Galeria" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Título ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="TÍTULO DA OBRA" />

            <EditText
                android:id="@+id/edtTitulo"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campo_bege"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/texto_escuro"
                android:textColorHint="@color/texto_hint"
                android:textSize="17sp"
                android:hint="Brisa Tropical"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:singleLine="true" />
        </LinearLayout>

        <!-- ===== Categoria ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="CATEGORIA" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/grupoCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPintura"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        android:checked="true"
                        android:text="Pintura" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEscultura"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        android:text="Escultura" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFotografia"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        android:text="Fotografia" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDigital"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        android:text="Digital" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ===== Preço ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="PREÇO EM REAIS" />

            <EditText
                android:id="@+id/edtPreco"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campo_bege"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/texto_escuro"
                android:textColorHint="@color/texto_hint"
                android:textSize="17sp"
                android:hint="1240"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:singleLine="true" />
        </LinearLayout>

        <!-- ===== Sobre a obra ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="SOBRE A OBRA" />

            <EditText
                android:id="@+id/edtDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campo_bege"
                android:gravity="top"
                android:hint="Técnica, tamanho e a história por trás da peça."
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="140dp"
                android:padding="20dp"
                android:textColor="@color/texto_escuro"
                android:textColorHint="@color/texto_hint"
                android:textSize="17sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublicar"
            style="@style/Atelie.Botao"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="Enviar para curadoria"
            app:backgroundTint="@color/coral_botao"
            app:cornerRadius="32dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
