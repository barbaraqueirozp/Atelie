<?xml version="1.0" encoding="utf-8"?>
<!-- Cadastro (ou edição) do ateliê do vendedor -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_creme"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/margem_tela"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnVoltar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_botao_circular"
                android:contentDescription="Voltar"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/texto_escuro"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txtEtapa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Meu ateliê"
                android:textColor="@color/texto_cinza"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Cadastrar ateliê"
            android:textColor="@color/texto_escuro"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:text="Conte onde você cria. O endereço só é mostrado para quem tiver uma visita confirmada."
            android:textColor="@color/texto_cinza"
            android:textSize="16sp" />

        <!-- ===== Nome ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="NOME DO ATELIÊ" />

            <EditText
                android:id="@+id/edtNomeAtelie"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campo_bege"
                android:hint="Ateliê Marina Duarte"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:singleLine="true"
                android:textColor="@color/texto_escuro"
                android:textColorHint="@color/texto_hint"
                android:textSize="16sp"
                android:maxLength="120" />
        </LinearLayout>

        <!-- ===== Especialidade ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="ESPECIALIDADE" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/grupoEspecialidade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPintura"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        android:checked="true"
                        android:text="Pintura" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEscultura"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        android:text="Escultura" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFotografia"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        android:text="Fotografia" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDigital"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        android:text="Digital" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ===== Endereço ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="ENDEREÇO DO ATELIÊ" />

            <EditText
                android:id="@+id/edtCep"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campo_bege"
                android:hint="CEP (só números)"
                android:importantForAutofill="no"
                android:inputType="number"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:singleLine="true"
                android:textColor="@color/texto_escuro"
                android:textColorHint="@color/texto_hint"
                android:textSize="16sp"
                android:maxLength="8" />

            <EditText
                android:id="@+id/edtLogradouro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_campo_bege"
                android:hint="Rua / avenida"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:singleLine="true"
                android:textColor="@color/texto_escuro"
                android:textColorHint="@color/texto_hint"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                android:id="@+id/edtNumero"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_campo_bege"
                android:hint="Número"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:singleLine="true"
                android:textColor="@color/texto_escuro"
                android:textColorHint="@color/texto_hint"
                android:textSize="16sp" />

                <EditText
                android:id="@+id/edtComplemento"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_campo_bege"
                android:hint="Complemento"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:singleLine="true"
                android:textColor="@color/texto_escuro"
                android:textColorHint="@color/texto_hint"
                android:textSize="16sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/edtBairro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_campo_bege"
                android:hint="Bairro"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:singleLine="true"
                android:textColor="@color/texto_escuro"
                android:textColorHint="@color/texto_hint"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                android:id="@+id/edtCidade"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_campo_bege"
                android:hint="Cidade"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:singleLine="true"
                android:textColor="@color/texto_escuro"
                android:textColorHint="@color/texto_hint"
                android:textSize="16sp" />

                <EditText
                android:id="@+id/edtEstado"
                android:layout_width="88dp"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_campo_bege"
                android:hint="UF"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:singleLine="true"
                android:textColor="@color/texto_escuro"
                android:textColorHint="@color/texto_hint"
                android:textSize="16sp"
                android:maxLength="2" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Localização e visitas ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="LOCALIZAÇÃO E VISITAS" />

            <TextView
                android:id="@+id/txtLocalizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Esteja no ateliê e toque no botão abaixo para registrar a localização exata. Ela é usada para mostrar a distância aos compradores."
                android:textColor="@color/texto_cinza"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEstouNoAtelie"
                style="@style/Atelie.Botao.Contorno"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:text="📍  Estou no meu ateliê" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchVisitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="true"
                android:text="Aceito visitas com agendamento"
                android:textColor="@color/texto_escuro"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ===== Dias e horário de visita ===== -->
        <LinearLayout
            android:id="@+id/secaoHorarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secao"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:text="DIAS E HORÁRIO DE VISITA"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cada visita dura 1 hora. Você pode mudar isso quando quiser em Meu ateliê."
                android:textColor="@color/texto_cinza"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:chipSpacingHorizontal="6dp"
                app:singleSelection="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSeg"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        app:chipMinHeight="44dp"
                        android:text="Seg" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTer"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        app:chipMinHeight="44dp"
                        android:checked="true"
                        android:text="Ter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipQua"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        app:chipMinHeight="44dp"
                        android:checked="true"
                        android:text="Qua" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipQui"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        app:chipMinHeight="44dp"
                        android:checked="true"
                        android:text="Qui" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSex"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        app:chipMinHeight="44dp"
                        android:checked="true"
                        android:text="Sex" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSab"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        app:chipMinHeight="44dp"
                        android:checked="true"
                        android:text="Sáb" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDom"
                        style="@style/Atelie.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@color/chip_fundo_bege"
                        app:chipMinHeight="44dp"
                        android:text="Dom" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAbertura"
                    style="@style/Atelie.Botao.Contorno"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Abre 10:00" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFechamento"
                    style="@style/Atelie.Botao.Contorno"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Fecha 18:00" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvar"
            style="@style/Atelie.Botao"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="Salvar ateliê"
            app:backgroundTint="@color/coral_botao"
            app:cornerRadius="32dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
