<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp">


        <!-- ========================= -->
        <!-- LOGO -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_logo"
                android:gravity="center"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ateliê"
                    android:textColor="#202033"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="mercado de arte"
                    android:textColor="#817977"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================= -->
        <!-- CARD -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_login"
            android:orientation="vertical"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">


            <!-- ========================= -->
            <!-- TÍTULO -->
            <!-- ========================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Criar sua conta"
                android:textColor="#202033"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Preencha seus dados para começar."
                android:textColor="#594E4D"
                android:textSize="15sp" />


            <!-- ========================= -->
            <!-- NOME -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtNome"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_campo_login"
                android:hint="Nome completo"
                android:inputType="textPersonName"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- ========================= -->
            <!-- CPF -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtCpf"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_campo_login"
                android:hint="CPF"
                android:inputType="number"
                android:maxLength="11"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- ========================= -->
            <!-- E-MAIL -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtEmailCadastro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_campo_login"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- ========================= -->
            <!-- SENHA -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtSenhaCadastro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_campo_login"
                android:hint="Senha"
                android:inputType="textPassword"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- ========================= -->
            <!-- CONFIRMAR SENHA -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtConfirmarSenha"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_campo_login"
                android:hint="Confirmar senha"
                android:inputType="textPassword"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- ========================= -->
            <!-- TÍTULO ENDEREÇO -->
            <!-- ========================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Endereço"
                android:textColor="#202033"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- ========================= -->
            <!-- CEP -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtCep"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_campo_login"
                android:hint="CEP"
                android:inputType="number"
                android:maxLength="8"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- ========================= -->
            <!-- RUA -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtRua"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_campo_login"
                android:hint="Rua / Avenida"
                android:inputType="textCapSentences"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- ========================= -->
            <!-- NÚMERO -->
            <!-- ========================= -->


            <!-- ========================= -->
            <!-- COMPLEMENTO -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtNumero"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_campo_login"
                android:hint="Número"
                android:inputType="number"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:singleLine="true"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/edtComplemento"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_campo_login"
                android:hint="Complemento (opcional)"
                android:inputType="textCapSentences"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- ========================= -->
            <!-- BAIRRO -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtBairro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_campo_login"
                android:hint="Bairro"
                android:inputType="textCapSentences"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- ========================= -->
            <!-- CIDADE -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtCidade"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_campo_login"
                android:hint="Cidade"
                android:inputType="textCapWords"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- ========================= -->
            <!-- ESTADO -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtEstado"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_campo_login"
                android:hint="Estado"
                android:inputType="textCapCharacters"
                android:maxLength="2"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#202033"
                android:textColorHint="#817977"
                android:textSize="16sp"
                android:singleLine="true" />


            <!-- ========================= -->
            <!-- CADASTRAR -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/btnCadastrar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="23dp"
                android:background="@drawable/bg_botao_entrar"
                android:gravity="center"
                android:text="Criar minha conta"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- JÁ TENHO CONTA -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/txtJaTenhoConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="25dp"
            android:text="Já tenho uma conta"
            android:textColor="#3575E6"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>