<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF4E4"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Cabeçalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_logo"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#FFF4E4"
                    android:textSize="23sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ateliê"
                        android:textColor="#261B16"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="mercado de arte"
                        android:textColor="#746C68"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnBusca"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_botao_branco"
                    android:contentDescription="Buscar obras"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#261B16"
                    android:textSize="29sp" />

                <TextView
                    android:id="@+id/btnArte"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_botao_roxo"
                    android:contentDescription="Explorar arte"
                    android:gravity="center"
                    android:text="✿"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp" />
            </LinearLayout>

            <!-- Localização, pesquisa e filtros -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnLocalizacao"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_filtro"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="⌖  Artistas próximos  ▾"
                    android:textColor="#261B16"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/campoBusca"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_filtro"
                        android:hint="Pesquisar artista ou obra"
                        android:inputType="text"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="#261B16"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnFiltros"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_filtro_ativo"
                        android:contentDescription="Abrir filtros"
                        android:gravity="center"
                        android:text="☷"
                        android:textColor="#FFFFFF"
                        android:textSize="27sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card laranja principal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_banner"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingExtra="-5dp"
                    android:text="Arte que&#10;você leva&#10;para casa."
                    android:textColor="#261B16"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Colecione peças originais direto dos ateliês de todo o Brasil."
                    android:textColor="#533129"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnExplorar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_botao_escuro"
                    android:text="Explorar obras"
                    android:textAllCaps="false"
                    android:textColor="#FFF4E4"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Obras em destaque -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Obras em destaque"
                    android:textColor="#261B16"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnVerTudo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver tudo"
                    android:textColor="#FF5B3D"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂"
            android:textColor="#261B16"
            android:textSize="30sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="◉"
            android:textColor="#AAAAAA"
            android:textSize="27sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="+"
            android:textColor="#FF5B3D"
            android:textSize="38sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡"
            android:textColor="#AAAAAA"
            android:textSize="32sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙"
            android:textColor="#AAAAAA"
            android:textSize="29sp" />
    </LinearLayout>

</LinearLayout>